# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/local-event-app

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

#EMAIL VERIFICATION
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
EMAIL_FROM=Eventify <yourgmail@gmail.com>
EMAIL_VERIFY_API_KEY=your_key_here

#BREVO DETAILS
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# SEED IMAGES
PIXABAY_API_KEY=your_key_here

# Cloudinary (image upload) - optional, falls back to local storage if empty
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client URL (for CORS)
CLIENT_URL=*
